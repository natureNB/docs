THEME=https://raw.githubusercontent.com/hpdipto/obsidian-ember/HEAD/theme.css
BASE_THEME=light
dgHomeLink=true
dgShowBacklinks=false
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=Atlantic Nature Resources | Ressources Nature Atlantique
TIMESTAMP_FORMAT=dd MMM, yyyy h:mm a
UI_SEARCH_BUTTON_TEXT=🔎
UI_SEARCH_PLACEHOLDER=Type here / Écrire ici
UI_SEARCH_NOT_STARTED_TEXT=Enter your search text in the box above / Entrez votre texte de recherche ci-dessus
UI_SEARCH_ENTER_HINT=Enter to select / Entrée pour sélectionner
UI_SEARCH_CLOSE_HINT=ESC close / fermer
UI_SEARCH_NO_RESULTS=No results... / Pas de résultats...
UI_SEARCH_PREVIEW_PLACEHOLDER=Select to preview / Sélectionner pour prévisualiser
UI_CANVAS_DRAG_HINT=Drag to pan / Glisser pour défiler
UI_CANVAS_ZOOM_HINT=Scroll to Zoom / Défiler pour grossir
UI_CANVAS_RESET_HINT=Double-click to reset / Double-cliquer pour réinitialiser
UI_SEARCH_ENTER_HOTKEY=Enter / Entrée
UI_SEARCH_NAVIGATE_HOTKEY=Up-Down / Haut-Bas
UI_SEARCH_NAVIGATE_HINT=to navigate / pour naviguer